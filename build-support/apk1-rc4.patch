+}
+.splash-character-screen h1 {
+  position: absolute;
+  z-index: 4;
+  top: 21.8%;
+  left: 50%;
+  width: 84%;
+  margin: 0;
+  padding: 0;
+  transform: translateX(-50%);
+  color: #5c65ae;
