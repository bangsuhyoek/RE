# 로컬에서는 이 파일을 .env.local로 복사한 뒤 실제 키를 입력합니다.
# Vercel 프로젝트 환경변수에도 같은 이름으로 등록합니다.
# 실제 키가 들어간 .env.local 파일은 GitHub에 커밋하지 않습니다.

# AI OCR (Gemini API 키 권장 또는 Google Vision API 키)
GEMINI_API_KEY=replace_with_your_gemini_api_key
# GOOGLE_VISION_API_KEY=replace_with_your_google_cloud_vision_api_key

# Supabase 데이터베이스 연동 (선택)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
