# 로컬에서는 이 파일을 .env로 복사한 뒤 실제 키를 입력합니다.
# 실제 키가 들어간 .env 파일은 GitHub에 커밋하지 않습니다.

# AI OCR 및 프로모션 비전 분석 (Gemini API 키)
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Gemini 기본 모델 (선택 사항, 기본값: gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite
# VITE_GEMINI_MODEL=gemini-3.5-flash-lite

# Gemini API 베이스 URL (선택 사항, 프록시/게이트웨이 연동 시 사용)
# GEMINI_API_BASE=https://generativelanguage.googleapis.com

# 챗봇 전용 Gemini 모델 (선택 사항, 기본값: gemini-3.5-flash)
# GEMINI_CHAT_MODEL=gemini-3.5-flash

# AI 해지 도우미 전용 Gemini 모델 (선택 사항, 기본값: gemini-3.5-flash-lite)
# GEMINI_CANCEL_MODEL=gemini-3.5-flash-lite

# Google Cloud Vision OCR 대체 API 키 (선택 사항)
# GOOGLE_VISION_API_KEY=your_google_vision_api_key

# Supabase 데이터베이스 연동 (클라이언트)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase 서버 사이드 환경변수 (Vercel Serverless Function용, 미설정 시 VITE_ 값으로 대체됨)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Supabase 서비스 롤 키 (서버 배치 및 관리자 권한 작업용, 클라이언트에 절대 노출 금지)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 프로젝트 전체 하루 Gemini 호출 상한 (기본값: 10000)
# GEMINI_GLOBAL_DAILY_LIMIT=10000

# 엔드포인트별 호출 할당량 (10분 / 1일)
# CHAT_QUOTA_10M=20
# CHAT_QUOTA_DAILY=150
# OCR_QUOTA_10M=20
# OCR_QUOTA_DAILY=100
# AGENT_QUOTA_10M=20
# AGENT_QUOTA_DAILY=150
# CANCEL_QUOTA_10M=30
# CANCEL_QUOTA_DAILY=200

# 모바일 앱(Capacitor) 빌드 시 배포된 백엔드 API 주소 (웹 배포 시 빈 값 유지)
VITE_API_BASE_URL=

# [로컬 개발 및 E2E 테스트 전용 - 운영 배포 시 절대 설정 금지]
# 로컬 개발/테스트 시 Supabase 로그인 없이 챗봇 API를 검증하기 위한 우회 플래그입니다.
# SUBMATE_DEV_CHAT_BYPASS=1
# VITE_SUBMATE_DEV_CHAT_BYPASS=1

