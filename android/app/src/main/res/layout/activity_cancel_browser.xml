<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- 상단 헤더 툴바 (52dp) -->
    <LinearLayout
        android:id="@+id/topHeader"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="12dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <!-- 자물쇠 / 보안 안내 -->
        <TextView
            android:id="@+id/tvLockIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="🔒"
            android:textSize="14sp"
            android:background="#F2F4F6" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvServiceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="서비스 이름"
                android:textColor="#191F28"
                android:textSize="14sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tvServiceUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="https://..."
                android:textColor="#8B95A1"
                android:textSize="11sp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- 외부 브라우저(크롬 등)로 열기 버튼: 구글 로그인 차단 회피 및 기존 로그인 세션 활용용 -->
        <TextView
            android:id="@+id/btnOpenExternal"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="🌐 브라우저"
            android:textColor="#4E5968"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="6dp"
            android:background="#F2F4F6"
            android:clickable="true"
            android:focusable="true" />

        <!-- 해지 완료 버튼 -->
        <TextView
            android:id="@+id/btnComplete"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="해지 완료"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="4dp"
            android:background="#191F28"
            android:clickable="true"
            android:focusable="true" />

        <!-- 닫기 (X) 버튼 -->
        <TextView
            android:id="@+id/btnClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#4E5968"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- 웹페이지 로딩 프로그레스바 -->
    <ProgressBar
        android:id="@+id/pbLoading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#3182F6"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5E8EB" />

    <!-- 로그인 필요 시 상단에 뜨는 1줄 안내 배너 -->
    <LinearLayout
        android:id="@+id/loginNoticeBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:background="#EFF6FF"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvLoginNoticeText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="로그인해 주세요. 로그인이 끝나면 꾸독이 이어서 진행해요."
            android:textColor="#1B64DA"
            android:background="@android:color/transparent"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnReturnAgentMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="꾸독에게 맡기기"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="#1B64DA"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- 중앙 네이티브 웹뷰 (약 73%) -->
    <FrameLayout
        android:id="@+id/webGuideFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webViewCancel"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.submate.app.webguide.GuideOverlayContainer
            android:id="@+id/guideOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 해지 에이전트 진행 화면: 꾸독이 공식 페이지를 대신 넘기는 동안 웹뷰를 덮는다 -->
        <LinearLayout
            android:id="@+id/agentCoverLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="40dp"
            android:paddingBottom="24dp"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvAgentStatusPill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="꾸독이 진행하는 중"
                    android:textColor="#3182F6"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAgentStepBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#8B95A1"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAgentHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="해지 페이지를 열고 있어요"
                android:textColor="#191F28"
                android:textSize="22sp"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:id="@+id/tvAgentSubtext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="해지 메뉴를 찾아 대신 넘겨 드릴게요. 해지 버튼은 누르기 전에 한 번씩 물어볼게요."
                android:textColor="#4E5968"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp" />

            <ProgressBar
                android:id="@+id/pbAgentWorking"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="24dp"
                android:indeterminate="true"
                android:indeterminateTint="#3182F6" />

            <TextView
                android:id="@+id/tvAgentTargetButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="공식 페이지에 연결하고 있어요"
                android:textColor="#8B95A1"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/ivAgentWebPreview"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="16dp"
                android:padding="1dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:background="@drawable/bg_card_rounded"
                android:contentDescription="해지 페이지 미리보기"
                android:visibility="gone" />

            <View
                android:id="@+id/agentCoverSpacer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnAgentFinalConfirm"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="해지 확정하기"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_danger"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnToggleWebView"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="화면 보면서 직접 할게요"
                android:textColor="#6B7684"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground" />
        </LinearLayout>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5E8EB" />

    <!-- 하단 연속 이미지 가이드 도크 (전체 화면의 20%, weight 20) -->
    <LinearLayout
        android:id="@+id/bottomGuideDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:background="#FFFFFF"
        android:elevation="6dp">

        <!-- 단계 번호 배지 및 한 줄 설명 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">


            <TextView
                android:id="@+id/tvStepBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1/4단계"
                android:textColor="#3182F6"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="#EFF6FF" />

            <TextView
                android:id="@+id/tvStepDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="가이드 설명이 여기에 표시됩니다."
                android:textColor="#191F28"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/btnManualOverride"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="직접 할게요"
                android:textColor="#E11D48"
                android:textSize="11sp"
                android:textStyle="bold"
                android:padding="8dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnToggleManualGuide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="단계별 방법"
                android:textColor="#6B7684"
                android:textSize="11sp"
                android:textStyle="bold"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- 연속 이미지 가로 스와이프 리스트 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGuideSteps"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:visibility="gone"
            android:orientation="horizontal"
            android:overScrollMode="never" />
    </LinearLayout>

</LinearLayout>
